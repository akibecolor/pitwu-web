---
import PageLayout from '../layouts/PageLayout.astro';

// 送信先は同一オリジンの Pages Function（functions/api/contact.ts）。
// そこから Google Apps Script のウェブアプリへサーバー側で転送する。
//
// 旧実装は Google フォームの formResponse へブラウザから直接 POST していたが、
// フォーム側が invisible reCAPTCHA を必須化したため常に HTTP 400 で破棄され、
// さらに mode:'no-cors' で失敗を検知できず「送信完了」と誤表示していた。
const FORM_ACTION = '/api/contact';

// 送信できないときの最終手段（公式フォーム／LINE）
const FALLBACK_FORM_URL =
  'https://docs.google.com/forms/d/e/1FAIpQLSdQNB3ZJfhKVE21mrWs9uJeF8ZQjO13gSZDpLgjKCJdGNlXow/viewform';
const LINE_URL = 'https://line.me/ti/p/%40cca1992y';
---

<PageLayout
  title="お問合せ | 夢源風人"
  description="夢源風人（大阪・東海）へのお問い合わせ窓口。ご質問・ご相談はこちらから。"
  pageTitle="お問合せ"
  pageSubtitle="Contact"
>
  <div class="contact-wrap">
    <p class="contact-lead">
      ご見学・メンバー募集・演舞依頼など、お気軽にお問い合わせください。<br />
      入力いただいたメールアドレスに受付確認メールをお送りします。
    </p>

    <form id="contact-form" class="contact-form" novalidate>
      <!-- ボット除け。人間には見えないので入力されていたら破棄する（サーバー側で判定） -->
      <div class="honeypot" aria-hidden="true">
        <label for="f-nickname">ニックネーム</label>
        <input type="text" id="f-nickname" name="nickname" tabindex="-1" autocomplete="off" />
      </div>

      <!-- メールアドレス -->
      <div class="form-group">
        <label class="form-label" for="f-email">
          メールアドレス <span class="required">必須</span>
        </label>
        <input
          class="form-input"
          type="email"
          id="f-email"
          name="email"
          required
          autocomplete="email"
          placeholder="your@email.com"
        />
      </div>

      <!-- お名前 -->
      <div class="form-group">
        <label class="form-label" for="f-name">
          お名前 <span class="required">必須</span>
        </label>
        <input
          class="form-input"
          type="text"
          id="f-name"
          name="name"
          required
          autocomplete="name"
          placeholder="例：山田 太郎"
        />
      </div>

      <!-- LINE -->
      <div class="form-group">
        <label class="form-label" for="f-line">
          LINE <span class="optional">任意</span>
        </label>
        <p class="form-hint">メールでの連絡に自信がない場合にご入力ください。</p>
        <input
          class="form-input"
          type="text"
          id="f-line"
          name="line"
          placeholder="LINE ID または表示名"
        />
      </div>

      <!-- X（旧Twitter） -->
      <div class="form-group">
        <label class="form-label" for="f-twitter">
          X（旧Twitter） <span class="optional">任意</span>
        </label>
        <p class="form-hint">メールでの連絡に自信がない場合にご入力ください。@mugenkajipitwu からDMします。</p>
        <input
          class="form-input"
          type="text"
          id="f-twitter"
          name="twitter"
          placeholder="@username"
        />
      </div>

      <!-- 年代 -->
      <div class="form-group">
        <label class="form-label" for="f-age">
          年代 <span class="required">必須</span>
        </label>
        <div class="select-wrap">
          <select class="form-input form-select" id="f-age" name="age" required>
            <option value="" disabled selected>選択してください</option>
            {['社会人-10代','社会人-20代','社会人-30代','社会人-40代以上','高校・大学・専門学生','小・中学生'].map((v) => (
              <option value={v}>{v}</option>
            ))}
          </select>
          <span class="select-arrow" aria-hidden="true">▾</span>
        </div>
      </div>

      <!-- 性別 -->
      <div class="form-group">
        <label class="form-label" for="f-gender">
          性別 <span class="required">必須</span>
        </label>
        <div class="select-wrap">
          <select class="form-input form-select" id="f-gender" name="gender" required>
            <option value="" disabled selected>選択してください</option>
            {['男性','女性'].map((v) => (
              <option value={v}>{v}</option>
            ))}
          </select>
          <span class="select-arrow" aria-hidden="true">▾</span>
        </div>
      </div>

      <!-- 投稿種別 -->
      <div class="form-group">
        <label class="form-label" for="f-type">
          投稿種別 <span class="required">必須</span>
        </label>
        <div class="select-wrap">
          <select class="form-input form-select" id="f-type" name="type" required>
            <option value="" disabled selected>選択してください</option>
            {['高知よさこい祭りに参加したい','練習会を見学したい','チームについて','ご依頼','その他'].map((v) => (
              <option value={v}>{v}</option>
            ))}
          </select>
          <span class="select-arrow" aria-hidden="true">▾</span>
        </div>
      </div>

      <!-- 質問内容 -->
      <div class="form-group">
        <label class="form-label" for="f-body">
          質問内容 <span class="required">必須</span>
        </label>
        <p class="form-hint">わからないこと、相談したいこと、確認したいことを教えてください。「その他」を選択された方は具体的な内容をお知らせください。</p>
        <textarea
          class="form-input form-textarea"
          id="f-body"
          name="body"
          required
          rows="6"
          placeholder="お問い合わせ内容をご記入ください"
        ></textarea>
      </div>

      <div id="form-error" class="form-error" hidden></div>

      <button type="submit" class="submit-btn" id="submit-btn">
        <span id="btn-text">送信する</span>
        <span id="btn-loading" class="btn-loading" hidden>
          <span class="spinner" aria-hidden="true"></span>送信中
        </span>
      </button>
    </form>

    <!-- 送信完了メッセージ -->
    <div id="form-success" class="form-success" role="status" hidden>
      <div class="success-icon" aria-hidden="true">✓</div>
      <h2>お問い合わせを受け付けました</h2>
      <p class="success-lead">ご入力いただいたメールアドレスに確認メールをお送りします。<br />
      しばらくしても届かない場合は、迷惑メールフォルダをご確認ください。</p>

      <!-- 送信内容の控え。メールを見ない方向けに、この場で保存できるようにする。
           スクリーンショットで1枚に収まるよう、白背景・枠つきのカードにまとめる。 -->
      <div class="receipt" id="receipt">
        <div class="receipt-head">
          <p class="receipt-title">お問い合わせ内容の控え</p>
          <p class="receipt-team">夢源風人（むげんかじぴとぅ）</p>
          <p class="receipt-date">受付日時：<span id="receipt-date"></span></p>
        </div>
        <dl class="receipt-list" id="receipt-list"></dl>
        <p class="receipt-url">https://pitwu.com/</p>
      </div>

      <div class="receipt-actions">
        <button type="button" class="copy-btn" id="copy-btn">
          <svg class="copy-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <rect x="9" y="9" width="11" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M5 15V5a2 2 0 0 1 2-2h10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <span id="copy-btn-label">内容をコピー</span>
        </button>
        <span class="copy-feedback" id="copy-feedback" aria-live="polite"></span>
      </div>
      <p class="receipt-hint">この控えはスクリーンショットでも保存できます。</p>
    </div>

    <div class="line-block">
      <p>連絡がうまくできない場合はLINEでも承ります</p>
      <a href={LINE_URL} target="_blank" rel="noopener noreferrer" class="line-btn">
        LINE で友だち追加
      </a>
    </div>
  </div>
</PageLayout>

<script define:vars={{ FORM_ACTION, FALLBACK_FORM_URL, LINE_URL }}>
  const form = document.getElementById('contact-form');
  const successEl = document.getElementById('form-success');
  const errorEl = document.getElementById('form-error');
  const submitBtn = document.getElementById('submit-btn');
  const btnText = document.getElementById('btn-text');
  const btnLoading = document.getElementById('btn-loading');

  // 送信できなかったときは必ずエラーを出し、代替の連絡手段を必ず提示する。
  // （成功扱いにして問い合わせを黙って捨てるのが以前の最大の問題だった）
  function showError(message) {
    errorEl.innerHTML = '';
    const p = document.createElement('p');
    p.className = 'form-error-msg';
    p.textContent = message;
    const alt = document.createElement('p');
    alt.className = 'form-error-alt';
    alt.innerHTML =
      'お急ぎの場合は <a href="' +
      LINE_URL +
      '" target="_blank" rel="noopener noreferrer">LINE</a>' +
      ' または <a href="' +
      FALLBACK_FORM_URL +
      '" target="_blank" rel="noopener noreferrer">Googleフォーム</a>' +
      ' からお問い合わせください。';
    errorEl.append(p, alt);
    errorEl.hidden = false;
    errorEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function setLoading(on) {
    submitBtn.disabled = on;
    submitBtn.setAttribute('aria-busy', String(on));
    btnText.hidden = on;
    btnLoading.hidden = !on;
  }

  // 控えに載せる項目と順番。任意項目は入力があるときだけ出す。
  const RECEIPT_FIELDS = [
    { key: 'name', label: 'お名前' },
    { key: 'email', label: 'メールアドレス' },
    { key: 'line', label: 'LINE', optional: true },
    { key: 'twitter', label: 'X（旧Twitter）', optional: true },
    { key: 'age', label: '年代' },
    { key: 'gender', label: '性別' },
    { key: 'type', label: '投稿種別' },
    { key: 'body', label: '質問内容' },
  ];

  // Apps Script が受付日時を返さなかったときの保険（日本時間で組み立てる）。
  function nowInJst() {
    const d = new Date();
    const jst = new Date(d.getTime() + (d.getTimezoneOffset() + 540) * 60000);
    const p = (n) => String(n).padStart(2, '0');
    return (
      jst.getFullYear() + '-' + p(jst.getMonth() + 1) + '-' + p(jst.getDate()) +
      ' ' + p(jst.getHours()) + ':' + p(jst.getMinutes()) + ':' + p(jst.getSeconds())
    );
  }

  let receiptText = '';

  function buildReceipt(payload, receivedAt) {
    const stamp = receivedAt || nowInJst();
    document.getElementById('receipt-date').textContent = stamp;

    const list = document.getElementById('receipt-list');
    list.innerHTML = '';
    const lines = [];

    for (const f of RECEIPT_FIELDS) {
      const value = (payload[f.key] || '').trim();
      if (!value && f.optional) continue;

      const dt = document.createElement('dt');
      dt.textContent = f.label;
      const dd = document.createElement('dd');
      // 質問内容は改行を保ったまま表示する
      dd.textContent = value;
      if (f.key === 'body') dd.className = 'receipt-body';
      list.append(dt, dd);

      lines.push(f.key === 'body' ? f.label + '：\n' + value : f.label + '：' + value);
    }

    // コピー用のプレーンテキスト（メールに貼っても読める形）
    receiptText = [
      '■ お問い合わせ内容の控え',
      '夢源風人（むげんかじぴとぅ）',
      '受付日時：' + stamp,
      '',
      ...lines,
      '',
      'https://pitwu.com/',
    ].join('\n');
  }

  const copyBtn = document.getElementById('copy-btn');
  const copyLabel = document.getElementById('copy-btn-label');
  const copyFeedback = document.getElementById('copy-feedback');

  copyBtn?.addEventListener('click', async () => {
    let copied = false;
    try {
      await navigator.clipboard.writeText(receiptText);
      copied = true;
    } catch {
      // 権限が無い/古い環境向けのフォールバック
      try {
        const ta = document.createElement('textarea');
        ta.value = receiptText;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        copied = document.execCommand('copy');
        document.body.removeChild(ta);
      } catch {
        copied = false;
      }
    }

    if (copied) {
      copyLabel.textContent = 'コピーしました';
      copyBtn.classList.add('is-copied');
      copyFeedback.textContent = '控えをクリップボードにコピーしました';
      setTimeout(() => {
        copyLabel.textContent = '内容をコピー';
        copyBtn.classList.remove('is-copied');
        copyFeedback.textContent = '';
      }, 2400);
    } else {
      copyFeedback.textContent = 'コピーできませんでした。長押しで選択してコピーしてください。';
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // バリデーション
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    setLoading(true);
    errorEl.hidden = true;

    const payload = Object.fromEntries(new FormData(form).entries());

    try {
      const res = await fetch(FORM_ACTION, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });

      // 同一オリジンなので本物のステータスと本文が読める。
      let result = {};
      try {
        result = await res.json();
      } catch {
        // 想定外の応答（HTML など）は失敗として扱う
      }

      if (!res.ok || result.ok !== true) {
        showError(result.error || '送信に失敗しました。時間をおいて再度お試しください。');
        setLoading(false);
        return;
      }

      // 完了画面に切り替える前にボタンを通常状態へ戻す。
      // （フォームは隠すが、状態を残したままにしない）
      setLoading(false);
      buildReceipt(payload, result.receivedAt);
      form.hidden = true;
      successEl.hidden = false;
      successEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch {
      // 通信断・オフラインなど
      showError('通信エラーで送信できませんでした。電波状況をご確認ください。');
      setLoading(false);
    }
  });
</script>

<style>
  .contact-wrap {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .contact-lead {
    font-size: 0.9375rem;
    line-height: 2;
    color: rgba(26, 31, 46, 0.75);
  }

  /* フォーム全体 */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  /* display を指定した要素は hidden 属性（UA の display:none）が効かなくなる。
     送信成功後にフォームが消えず「送信中...」が残る不具合の原因だったので明示する。 */
  .contact-form[hidden] {
    display: none;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-fieldset {
    border: none;
    padding: 0;
    margin: 0;
  }

  .form-label {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink, #1A1F2E);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .required {
    font-size: 0.6875rem;
    font-weight: 700;
    color: #ffffff;
    background: #e53e3e;
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    letter-spacing: 0.05em;
  }

  .optional {
    font-size: 0.6875rem;
    font-weight: 500;
    color: rgba(26, 31, 46, 0.45);
    border: 1px solid rgba(26, 31, 46, 0.2);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    letter-spacing: 0.05em;
  }

  .form-hint {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: rgba(26, 31, 46, 0.55);
    margin: 0;
  }

  .form-input {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.9375rem;
    color: var(--color-ink, #1A1F2E);
    background: #ffffff;
    border: 1.5px solid rgba(27, 63, 139, 0.2);
    border-radius: 6px;
    padding: 0.75rem 1rem;
    width: 100%;
    box-sizing: border-box;
    transition: border-color 0.2s, box-shadow 0.2s;
    outline: none;
  }

  .form-input:focus {
    border-color: var(--color-deep, #1B3F8B);
    box-shadow: 0 0 0 3px rgba(27, 63, 139, 0.12);
  }

  .form-input::placeholder {
    color: rgba(26, 31, 46, 0.3);
  }

  .form-textarea {
    resize: vertical;
    min-height: 140px;
    line-height: 1.7;
  }

  /* セレクトボックス */
  .select-wrap {
    position: relative;
  }

  .form-select {
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
    padding-right: 2.5rem;
  }

  .form-select:invalid {
    color: rgba(26, 31, 46, 0.35);
  }

  .select-arrow {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--color-deep, #1B3F8B);
    font-size: 0.875rem;
  }

  /* ボット除け（画面外へ逃がす。display:none だと入力してくるボットがいる） */
  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* エラー */
  .form-error {
    background: #fff5f5;
    border: 1.5px solid #fc8181;
    border-radius: 6px;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    color: #c53030;
    line-height: 1.6;
  }

  .form-error-msg {
    font-weight: 700;
    margin: 0;
  }

  .form-error-alt {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
  }

  .form-error-alt a {
    color: #c53030;
    font-weight: 700;
    text-decoration: underline;
  }

  /* 送信ボタン */
  .submit-btn {
    align-self: flex-start;
    /* 「送信する」と「送信中」で幅が跳ねないよう中央揃え＋最小幅を持たせる */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 11rem;
    padding: 0.9rem 2.5rem;
    background: var(--color-deep, #1B3F8B);
    color: #ffffff;
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s, opacity 0.2s;
  }

  /* 送信中の表示（スピナー＋テキスト） */
  .btn-loading {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* display 指定により hidden 属性が効かなくなるため明示（.contact-form と同じ理由） */
  .btn-loading[hidden] {
    display: none;
  }

  .spinner {
    width: 1em;
    height: 1em;
    flex-shrink: 0;
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: spinner-rotate 0.7s linear infinite;
  }

  @keyframes spinner-rotate {
    to {
      transform: rotate(360deg);
    }
  }

  /* アニメーションを控えたい設定の環境ではゆっくり回す */
  @media (prefers-reduced-motion: reduce) {
    .spinner {
      animation-duration: 2.4s;
    }
  }

  .submit-btn:hover:not(:disabled) {
    background: #2a5298;
    transform: translateY(-1px);
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* 送信完了 */
  /* 面はサイトのパレット（白＋群青）で構成し、緑はチェックバッジだけに絞る。
     ページ背景が白濁(--color-base #F0F6FF)なので、白のカードが自然に浮き上がる。 */
  .form-success {
    background: var(--color-white, #ffffff);
    border: 1.5px solid rgba(27, 63, 139, 0.25);
    border-radius: 12px;
    padding: 3rem 2rem;
    text-align: center;
    box-shadow: 0 2px 16px rgba(27, 63, 139, 0.06);
  }

  /* 緑の丸バッジに白のチェック。「成功」の一目瞭然さはここで担保する */
  .success-icon {
    width: 3.25rem;
    height: 3.25rem;
    margin: 0 auto 1.125rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #38a169;
    color: #ffffff;
    border-radius: 50%;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
  }

  .form-success h2 {
    font-family: 'Noto Serif JP', serif;
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-deep, #1B3F8B);
    margin-bottom: 0.75rem;
  }

  .form-success p {
    font-size: 0.9375rem;
    line-height: 2;
    color: rgba(26, 31, 46, 0.7);
  }

  /* ===== 送信内容の控え ===== */
  /* スクリーンショットで1枚に収まるよう、枠つきで情報を密に置く。
     外側が白カードなので、控えは淡い青地にして面を分離する。 */
  .receipt {
    margin: 1.75rem auto 0;
    max-width: 34rem;
    background: #f7faff;
