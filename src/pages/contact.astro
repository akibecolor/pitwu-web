---
import PageLayout from '../layouts/PageLayout.astro';

// 送信先は同一オリジンの Pages Function（functions/api/contact.ts）。
// そこから Google Apps Script のウェブアプリへサーバー側で転送する。
//
// 旧実装は Google フォームの formResponse へブラウザから直接 POST していたが、
// フォーム側が invisible reCAPTCHA を必須化したため常に HTTP 400 で破棄され、
// さらに mode:'no-cors' で失敗を検知できず「送信完了」と誤表示していた。
const FORM_ACTION = '/api/contact';

// 送信できないときの最終手段（公式フォーム／LINE）
const FALLBACK_FORM_URL =
  'https://docs.google.com/forms/d/e/1FAIpQLSdQNB3ZJfhKVE21mrWs9uJeF8ZQjO13gSZDpLgjKCJdGNlXow/viewform';
const LINE_URL = 'https://line.me/ti/p/%40cca1992y';
---

<PageLayout
  title="お問合せ | 夢源風人"
  description="夢源風人（大阪・東海）へのお問い合わせ窓口。ご質問・ご相談はこちらから。"
  pageTitle="お問合せ"
  pageSubtitle="Contact"
>
  <div class="contact-wrap">
    <p class="contact-lead">
      ご見学・メンバー募集・演舞依頼など、お気軽にお問い合わせください。<br />
      入力いただいたメールアドレスに受付確認メールをお送りします。
    </p>

    <form id="contact-form" class="contact-form" novalidate>
      <!-- ボット除け。人間には見えないので入力されていたら破棄する（サーバー側で判定） -->
      <div class="honeypot" aria-hidden="true">
        <label for="f-nickname">ニックネーム</label>
        <input type="text" id="f-nickname" name="nickname" tabindex="-1" autocomplete="off" />
      </div>

      <!-- メールアドレス -->
      <div class="form-group">
        <label class="form-label" for="f-email">
          メールアドレス <span class="required">必須</span>
        </label>
        <input
          class="form-input"
          type="email"
          id="f-email"
          name="email"
          required
          autocomplete="email"
          placeholder="your@email.com"
        />
      </div>

      <!-- お名前 -->
      <div class="form-group">
        <label class="form-label" for="f-name">
          お名前 <span class="required">必須</span>
        </label>
        <input
          class="form-input"
          type="text"
          id="f-name"
          name="name"
          required
          autocomplete="name"
          placeholder="例：山田 太郎"
        />
      </div>

      <!-- LINE -->
      <div class="form-group">
        <label class="form-label" for="f-line">
          LINE <span class="optional">任意</span>
        </label>
        <p class="form-hint">メールでの連絡に自信がない場合にご入力ください。</p>
        <input
          class="form-input"
          type="text"
          id="f-line"
          name="line"
          placeholder="LINE ID または表示名"
        />
      </div>

      <!-- X（旧Twitter） -->
      <div class="form-group">
        <label class="form-label" for="f-twitter">
          X（旧Twitter） <span class="optional">任意</span>
        </label>
        <p class="form-hint">メールでの連絡に自信がない場合にご入力ください。@mugenkajipitwu からDMします。</p>
        <input
          class="form-input"
          type="text"
          id="f-twitter"
          name="twitter"
          placeholder="@username"
        />
      </div>

      <!-- 年代 -->
      <div class="form-group">
        <label class="form-label" for="f-age">
          年代 <span class="required">必須</span>
        </label>
        <div class="select-wrap">
          <select class="form-input form-select" id="f-age" name="age" required>
            <option value="" disabled selected>選択してください</option>
            {['社会人-10代','社会人-20代','社会人-30代','社会人-40代以上','高校・大学・専門学生','小・中学生'].map((v) => (
              <option value={v}>{v}</option>
            ))}
          </select>
          <span class="select-arrow" aria-hidden="true">▾</span>
        </div>
      </div>

      <!-- 性別 -->
      <div class="form-group">
        <label class="form-label" for="f-gender">
          性別 <span class="required">必須</span>
        </label>
        <div class="select-wrap">
          <select class="form-input form-select" id="f-gender" name="gender" required>
            <option value="" disabled selected>選択してください</option>
            {['男性','女性'].map((v) => (
              <option value={v}>{v}</option>
            ))}
          </select>
          <span class="select-arrow" aria-hidden="true">▾</span>
        </div>
      </div>

      <!-- 投稿種別 -->
      <div class="form-group">
        <label class="form-label" for="f-type">
          投稿種別 <span class="required">必須</span>
        </label>
        <div class="select-wrap">
          <select class="form-input form-select" id="f-type" name="type" required>
            <option value="" disabled selected>選択してください</option>
            {['高知よさこい祭りに参加したい','練習会を見学したい','チームについて','ご依頼','その他'].map((v) => (
              <option value={v}>{v}</option>
            ))}
          </select>
          <span class="select-arrow" aria-hidden="true">▾</span>
        </div>
      </div>

      <!-- 質問内容 -->
      <div class="form-group">
        <label class="form-label" for="f-body">
          質問内容 <span class="required">必須</span>
        </label>
        <p class="form-hint">わからないこと、相談したいこと、確認したいことを教えてください。「その他」を選択された方は具体的な内容をお知らせください。</p>
        <textarea
          class="form-input form-textarea"
          id="f-body"
          name="body"
          required
          rows="6"
          placeholder="お問い合わせ内容をご記入ください"
        ></textarea>
      </div>

      <div id="form-error" class="form-error" hidden></div>

      <button type="submit" class="submit-btn" id="submit-btn">
        <span id="btn-text">送信する</span>
        <span id="btn-loading" hidden>送信中...</span>
      </button>
    </form>

    <!-- 送信完了メッセージ -->
    <div id="form-success" class="form-success" hidden>
      <div class="success-icon" aria-hidden="true">✓</div>
      <h2>お問い合わせを受け付けました</h2>
      <p>ご入力いただいたメールアドレスに確認メールをお送りします。<br />
      しばらくしても届かない場合は、迷惑メールフォルダをご確認ください。</p>
    </div>

    <div class="line-block">
      <p>連絡がうまくできない場合はLINEでも承ります</p>
      <a href={LINE_URL} target="_blank" rel="noopener noreferrer" class="line-btn">
        LINE で友だち追加
      </a>
    </div>
  </div>
</PageLayout>

<script define:vars={{ FORM_ACTION, FALLBACK_FORM_URL, LINE_URL }}>
  const form = document.getElementById('contact-form');
  const successEl = document.getElementById('form-success');
  const errorEl = document.getElementById('form-error');
  const submitBtn = document.getElementById('submit-btn');
  const btnText = document.getElementById('btn-text');
  const btnLoading = document.getElementById('btn-loading');

  // 送信できなかったときは必ずエラーを出し、代替の連絡手段を必ず提示する。
  // （成功扱いにして問い合わせを黙って捨てるのが以前の最大の問題だった）
  function showError(message) {
    errorEl.innerHTML = '';
    const p = document.createElement('p');
    p.className = 'form-error-msg';
    p.textContent = message;
    const alt = document.createElement('p');
    alt.className = 'form-error-alt';
    alt.innerHTML =
      'お急ぎの場合は <a href="' +
      LINE_URL +
      '" target="_blank" rel="noopener noreferrer">LINE</a>' +
      ' または <a href="' +
      FALLBACK_FORM_URL +
      '" target="_blank" rel="noopener noreferrer">Googleフォーム</a>' +
      ' からお問い合わせください。';
    errorEl.append(p, alt);
    errorEl.hidden = false;
    errorEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function setLoading(on) {
    submitBtn.disabled = on;
    btnText.hidden = on;
    btnLoading.hidden = !on;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // バリデーション
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    setLoading(true);
    errorEl.hidden = true;

    const payload = Object.fromEntries(new FormData(form).entries());

    try {
      const res = await fetch(FORM_ACTION, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });

      // 同一オリジンなので本物のステータスと本文が読める。
      let result = {};
      try {
        result = await res.json();
      } catch {
        // 想定外の応答（HTML など）は失敗として扱う
      }

      if (!res.ok || result.ok !== true) {
        showError(result.error || '送信に失敗しました。時間をおいて再度お試しください。');
        setLoading(false);
        return;
      }

      form.hidden = true;
      successEl.hidden = false;
      successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch {
      // 通信断・オフラインなど
      showError('通信エラーで送信できませんでした。電波状況をご確認ください。');
      setLoading(false);
    }
  });
</script>

<style>
  .contact-wrap {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .contact-lead {
    font-size: 0.9375rem;
    line-height: 2;
    color: rgba(26, 31, 46, 0.75);
  }

  /* フォーム全体 */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-fieldset {
    border: none;
    padding: 0;
    margin: 0;
  }

  .form-label {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink, #1A1F2E);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .required {
    font-size: 0.6875rem;
    font-weight: 700;
    color: #ffffff;
    background: #e53e3e;
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    letter-spacing: 0.05em;
  }

  .optional {
    font-size: 0.6875rem;
    font-weight: 500;
    color: rgba(26, 31, 46, 0.45);
    border: 1px solid rgba(26, 31, 46, 0.2);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    letter-spacing: 0.05em;
  }

  .form-hint {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: rgba(26, 31, 46, 0.55);
    margin: 0;
  }

  .form-input {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.9375rem;
    color: var(--color-ink, #1A1F2E);
    background: #ffffff;
    border: 1.5px solid rgba(27, 63, 139, 0.2);
    border-radius: 6px;
    padding: 0.75rem 1rem;
    width: 100%;
    box-sizing: border-box;
    transition: border-color 0.2s, box-shadow 0.2s;
    outline: none;
  }

  .form-input:focus {
    border-color: var(--color-deep, #1B3F8B);
    box-shadow: 0 0 0 3px rgba(27, 63, 139, 0.12);
  }

  .form-input::placeholder {
    color: rgba(26, 31, 46, 0.3);
  }

  .form-textarea {
    resize: vertical;
    min-height: 140px;
    line-height: 1.7;
  }

  /* セレクトボックス */
  .select-wrap {
    position: relative;
  }

  .form-select {
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
    padding-right: 2.5rem;
  }

  .form-select:invalid {
    color: rgba(26, 31, 46, 0.35);
  }

  .select-arrow {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--color-deep, #1B3F8B);
    font-size: 0.875rem;
  }

  /* ボット除け（画面外へ逃がす。display:none だと入力してくるボットがいる） */
  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* エラー */
  .form-error {
    background: #fff5f5;
    border: 1.5px solid #fc8181;
    border-radius: 6px;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    color: #c53030;
    line-height: 1.6;
  }

  .form-error-msg {
    font-weight: 700;
    margin: 0;
  }

  .form-error-alt {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
  }

  .form-error-alt a {
    color: #c53030;
    font-weight: 700;
    text-decoration: underline;
  }

  /* 送信ボタン */
  .submit-btn {
    align-self: flex-start;
    padding: 0.9rem 2.5rem;
    background: var(--color-deep, #1B3F8B);
    color: #ffffff;
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s, opacity 0.2s;
  }

  .submit-btn:hover:not(:disabled) {
    background: #2a5298;
    transform: translateY(-1px);
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* 送信完了 */
  .form-success {
    background: #f0fff4;
    border: 1.5px solid #68d391;
    border-radius: 12px;
    padding: 3rem 2rem;
    text-align: center;
  }

  .success-icon {
    font-size: 3rem;
    color: #38a169;
    margin-bottom: 1rem;
    font-weight: 700;
  }

  .form-success h2 {
    font-family: 'Noto Serif JP', serif;
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-deep, #1B3F8B);
    margin-bottom: 0.75rem;
  }

  .form-success p {
    font-size: 0.9375rem;
    line-height: 2;
    color: rgba(26, 31, 46, 0.7);
  }

  /* LINE ブロック */
  .line-block {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    background: var(--color-base, #F0F6FF);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
  }

  .line-block p {
    font-size: 0.875rem;
    color: rgba(26, 31, 46, 0.65);
    flex: 1;
    min-width: 200px;
  }

  .line-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    background: #06C755;
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 700;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.2s;
    white-space: nowrap;
  }

  .line-btn:hover {
    background: #05a847;
  }
</style>
