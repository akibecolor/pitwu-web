---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getAllArticles } from '../../lib/microcms.js';
import type { GetStaticPaths, Page } from 'astro';
import type { Article } from '../../types/index.js';

// 約2,000件を1ページに描画していた問題を解消するためページ分割する。
// rest パラメータ([...page])にすることで 1 ページ目は /articles/、2 ページ目以降は /articles/2 となる。
export const getStaticPaths = (async ({ paginate }) => {
  const articles = await getAllArticles();
  return paginate(articles, { pageSize: 18 });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Article>;
}
const { page } = Astro.props;

// 1 ページ目だけ先頭記事を大きく見せる（従来のマガジン型レイアウトを踏襲）。
const isFirst = page.currentPage === 1;
const featured = isFirst ? page.data[0] : null;
const rest = isFirst ? page.data.slice(1) : page.data;
---

<BaseLayout
  title={isFirst ? '記事一覧 | 夢源風人' : `記事一覧 (${page.currentPage}ページ目) | 夢源風人`}
  description="大阪・東海を拠点に活動する夢源風人の活動報告・コラムなど、記事の一覧です。"
>
  <div class="articles-page">
    <div class="page-inner">
      <header class="page-header">
        <h1 class="page-title">
          <span class="page-title-en">Articles</span>
          記事一覧
        </h1>
      </header>

      {page.data.length === 0 ? (
        <p class="no-articles">記事はまだありません。</p>
      ) : (
        <div class="magazine-layout">
          {featured && (
            <div class="featured-wrap">
              <ArticleCard article={featured} featured={true} />
            </div>
          )}

          {rest.length > 0 && (
            <div class="articles-grid" data-articles-grid>
              {rest.map((article) => (
                <ArticleCard article={article} />
              ))}
            </div>
          )}
        </div>
      )}

      {/*
        「もっと読む」: ページ送りルート(/articles/N)をデータ源に、次ページのカードを
        JS で取得して追記する（スクロールで自動／クリックでも可）。
        JS 無効時はそのまま次ページへ遷移するリンクとして機能する（段階的強化）。
      */}
      {page.url.next && (
        <div class="load-more-wrap">
          <a class="load-more" href={page.url.next} rel="next" data-load-more>
            もっと読む
          </a>
        </div>
      )}
    </div>
  </div>

  <script>
    function setupLoadMore() {
      const grid = document.querySelector('[data-articles-grid]');
      const button = document.querySelector<HTMLAnchorElement>('[data-load-more]');
      if (!grid || !button) return;

      let nextUrl: string | null = button.getAttribute('href');
      let loading = false;

      async function loadNext() {
        if (!nextUrl || loading || !button || !grid) return;
        loading = true;
        button.textContent = '読み込み中…';
        try {
          const res = await fetch(nextUrl);
          if (!res.ok) throw new Error(String(res.status));
          const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
          const newCards = doc.querySelectorAll('[data-articles-grid] > *');
          newCards.forEach((card) => grid.appendChild(document.importNode(card, true)));
          nextUrl =
            doc.querySelector('[data-load-more]')?.getAttribute('href') ?? null;
        } catch {
          // 失敗時はボタンを残してリトライ可能にする
          button.textContent = 'もっと読む';
          loading = false;
          return;
        }
        loading = false;
        if (nextUrl) {
          button.setAttribute('href', nextUrl);
          button.textContent = 'もっと読む';
        } else {
          observer?.disconnect();
          button.remove();
        }
      }

      button.addEventListener('click', (e) => {
        e.preventDefault();
        loadNext();
      });

      // スクロールで自動読み込み（無限スクロール）。ボタンが近づいたら取得。
      let observer: IntersectionObserver | null = null;
      if ('IntersectionObserver' in window) {
        observer = new IntersectionObserver(
          (entries) => {
            if (entries[0]?.isIntersecting) loadNext();
          },
          { rootMargin: '600px' }
        );
        observer.observe(button);
      }
    }

    setupLoadMore();
  </script>
</BaseLayout>

<style>
  .articles-page {
    padding-top: 64px; /* header height */
    min-height: 80vh;
  }

  .page-inner {
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }

  .page-header {
    margin-bottom: 3rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(110, 198, 240, 0.3);
  }

  .page-title {
    font-family: 'Noto Serif JP', serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-deep, #1B3F8B);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .page-title-en {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.875rem;
    font-weight: 300;
    letter-spacing: 0.35em;
    color: var(--color-sky, #6EC6F0);
    text-transform: uppercase;
  }

  .no-articles {
    text-align: center;
    color: rgba(26, 31, 46, 0.5);
    padding: 4rem 0;
    font-size: 1rem;
  }

  /* マガジン型レイアウト */
  .magazine-layout {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .featured-wrap {
    /* featured article takes full width */
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }

  /* もっと読む */
  .load-more-wrap {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  .load-more {
    display: inline-block;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-deep, #1B3F8B);
    text-decoration: none;
    padding: 0.7rem 2.5rem;
    border: 1px solid rgba(27, 63, 139, 0.3);
    border-radius: 999px;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    cursor: pointer;
  }

  .load-more:hover {
    background: var(--color-deep, #1B3F8B);
    color: #fff;
    border-color: var(--color-deep, #1B3F8B);
  }
</style>
