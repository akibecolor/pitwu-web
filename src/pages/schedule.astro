---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="スケジュール | 夢源風人"
  description="夢源風人が出演する祭り・イベントの予定。月ごとのカレンダーで確認できます。"
  pageTitle="スケジュール"
  pageSubtitle="Schedule"
>
  <div class="schedule-wrap">
    <p class="schedule-lead">夢源風人が出演する祭り・イベントの予定です。予定は変更になる場合があります。</p>

    <div class="calendar-card">
      <div class="cal-nav">
        <button type="button" class="nav-btn" id="cal-prev" aria-label="前の月">◀<span class="nav-txt"> 前の月</span></button>
        <h2 id="cal-label" class="cal-label" aria-live="polite"></h2>
        <button type="button" class="nav-btn" id="cal-next" aria-label="次の月"><span class="nav-txt">次の月 </span>▶</button>
      </div>
      <div class="cal-week" aria-hidden="true">
        <span class="sun">日</span><span>月</span><span>火</span><span>水</span><span>木</span><span>金</span><span class="sat">土</span>
      </div>
      <div id="cal-grid" class="cal-grid" aria-hidden="true"></div>
    </div>

    <section class="month-list" aria-labelledby="list-heading">
      <h3 id="list-heading" class="list-heading"></h3>
      <div id="cal-list" aria-live="polite">
        <p class="cal-empty">予定を読み込んでいます…</p>
      </div>
    </section>

    <p class="schedule-footer">
      出演のご依頼・ご不明な点は<a href="/contact/">お問合せ</a>ください。
    </p>
  </div>
</PageLayout>

<script>
  import {
    buildMonthWeeks,
    isPastEvent,
    japaneseHolidays,
    previousMonthStart,
    todayInTokyo,
    weekdayOf,
    ymd,
    type CalendarEvent,
  } from '../lib/calendar';

  const WEEKDAYS = ['日', '月', '火', '水', '木', '金', '土'];
  const today = todayInTokyo();
  // /api/calendar が返すのは前の月の1日から。それより前の月は予定が無いように見えるので戻れなくする
  const earliest = previousMonthStart(today);
  let year = Number(today.slice(0, 4));
  let month = Number(today.slice(5, 7));
  let events: CalendarEvent[] = [];
  let loaded = false;
  let failed = false;
  const holidayCache = new Map<number, Set<string>>();

  const isHoliday = (d: string): boolean => {
    const y = Number(d.slice(0, 4));
    if (!holidayCache.has(y)) holidayCache.set(y, japaneseHolidays(y));
    return holidayCache.get(y)?.has(d) ?? false;
  };
  const dayClass = (d: string): string =>
    weekdayOf(d) === 0 || isHoliday(d) ? 'sun' : weekdayOf(d) === 6 ? 'sat' : '';

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
  };

  function inMonth(ev: CalendarEvent): boolean {
    const first = `${year}-${String(month).padStart(2, '0')}-01`;
    const last = `${year}-${String(month).padStart(2, '0')}-31`;
    return ev.startDate <= last && ev.endInclusive >= first;
  }

  function renderGrid(): void {
    const grid = document.getElementById('cal-grid');
    if (!grid) return;
    const frag = document.createDocumentFragment();
    for (const wk of buildMonthWeeks(year, month, events.filter(inMonth))) {
      const row = el('div', 'cal-row');
      row.style.setProperty('--lanes', String(Math.max(wk.laneCount, 2)));
      wk.days.forEach((d, c) => {
        const cell = el('div', 'cal-cell');
        cell.style.gridColumn = String(c + 1);
        if (d) {
          if (d < today) cell.classList.add('is-past');
          if (d === today) cell.classList.add('is-today');
          const num = el('span', `cal-day ${dayClass(d)}`, String(Number(d.slice(8))));
          num.style.gridColumn = String(c + 1);
          row.append(cell, num);
        } else {
          cell.classList.add('is-blank');
          row.append(cell);
        }
      });
      for (const sg of wk.segments) {
        const ev = sg.event;
        const label = (sg.head ? '' : '◀ ') + ev.title + (sg.tail ? '' : ' ▶');
        const bar = el('span', 'cal-bar', label);
        bar.title = ev.title;
        if (sg.multi) bar.classList.add('is-multi');
        if (sg.multi && !sg.head) bar.classList.add('cont-l');
        if (sg.multi && !sg.tail) bar.classList.add('cont-r');
        if (isPastEvent(ev, today)) bar.classList.add('is-past');
        bar.style.gridColumn = `${sg.col + 1} / span ${sg.span}`;
        bar.style.gridRow = String(sg.lane + 2);
        row.append(bar);
      }
      frag.append(row);
    }
    grid.replaceChildren(frag);
  }

  function whenLabel(ev: CalendarEvent): { date: string; wd: string; cls: string } {
    const [, sm, sd] = ev.startDate.split('-').map(Number);
    if (ev.startDate === ev.endInclusive) {
      return { date: `${sm}/${sd}`, wd: WEEKDAYS[weekdayOf(ev.startDate)], cls: dayClass(ev.startDate) };
    }
    const [, em, ed] = ev.endInclusive.split('-').map(Number);
    return {
      date: sm === em ? `${sm}/${sd}〜${ed}` : `${sm}/${sd}〜${em}/${ed}`,
      wd: `${WEEKDAYS[weekdayOf(ev.startDate)]}〜${WEEKDAYS[weekdayOf(ev.endInclusive)]}`,
      cls: '',
    };
  }

  function buildRow(ev: CalendarEvent): HTMLLIElement {
    const li = el('li', 'list-row');
    if (isPastEvent(ev, today)) li.classList.add('is-past');
    const w = whenLabel(ev);
    const blk = el('div', 'list-when');
    blk.append(el('span', 'list-date', w.date), el('span', `list-wd ${w.cls}`, w.wd));
    const body = el('div', 'list-body');
    body.append(el('span', 'list-title', ev.title));
    const meta = [ev.startTime, ev.location].filter(Boolean).join('　');
    if (meta) body.append(el('span', 'list-meta', meta));
    li.append(blk, body);
    return li;
  }

  function renderList(): void {
    const heading = document.getElementById('list-heading');
    const root = document.getElementById('cal-list');
    if (!heading || !root) return;
    heading.textContent = `${month}月の予定`;
    if (!loaded) return;
    if (failed) {
      root.innerHTML = '<p class="cal-empty">予定の読み込みに失敗しました。時間をおいて再度お試しください。</p>';
      return;
    }
    const list = events.filter(inMonth);
    if (!list.length) {
      root.innerHTML = '<p class="cal-empty">この月の予定はありません。</p>';
      return;
    }
    const past = list.filter((e) => isPastEvent(e, today));
    const rest = list.filter((e) => !isPastEvent(e, today));
    const frag = document.createDocumentFragment();
    if (past.length) {
      const pastUl = el('ul', 'list past-list');
      pastUl.id = 'past-list';
      pastUl.hidden = true;
      for (const e of past) pastUl.append(buildRow(e));
      const btn = el('button', 'fold', `終了した予定（${past.length}件）を見る ▼`);
      btn.setAttribute('type', 'button');
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-controls', 'past-list');
      btn.addEventListener('click', () => {
        const open = pastUl.hidden;
        pastUl.hidden = !open;
        btn.setAttribute('aria-expanded', String(open));
        btn.textContent = open ? `終了した予定（${past.length}件）を閉じる ▲` : `終了した予定（${past.length}件）を見る ▼`;
      });
      frag.append(btn, pastUl);
    }
    if (rest.length) {
      const ul = el('ul', 'list');
      for (const e of rest) ul.append(buildRow(e));
      frag.append(ul);
    } else {
      frag.append(el('p', 'cal-empty', 'この月のこれからの予定はありません。'));
    }
    root.replaceChildren(frag);
  }

  function render(): void {
    const label = document.getElementById('cal-label');
    if (label) label.textContent = `${year}年${month}月`;
    const prev = document.getElementById('cal-prev') as HTMLButtonElement | null;
    if (prev) prev.disabled = ymd(year, month, 1) <= earliest;
    renderGrid();
    renderList();
  }

  function shift(n: number): void {
    if (n < 0 && ymd(year, month, 1) <= earliest) return;
    month += n;
    if (month < 1) { month = 12; year--; }
    if (month > 12) { month = 1; year++; }
    render();
  }

  document.getElementById('cal-prev')?.addEventListener('click', () => shift(-1));
  document.getElementById('cal-next')?.addEventListener('click', () => shift(1));

  render();
  (async () => {
    try {
      const res = await fetch('/api/calendar');
      const data = (await res.json()) as { events?: CalendarEvent[]; error?: string };
      if (data.error) failed = true;
      // /schedule/ は外部公開の「祭り・イベント」だけ（練習は出さない）
      events = (data.events ?? []).filter((e) => e.kind === '祭り・イベント');
    } catch {
      failed = true;
    }
    loaded = true;
    render();
  })();
</script>

<style>
  .schedule-wrap {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .schedule-lead {
    font-size: 0.95rem;
    line-height: 1.8;
    color: rgba(26, 31, 46, 0.75);
  }

  .calendar-card {
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(27, 63, 139, 0.1);
    border: 1px solid rgba(27, 63, 139, 0.08);
    padding: 1rem;
  }

  .cal-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .cal-label {
    font-family: 'Noto Serif JP', serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-deep, #1B3F8B);
  }

  .nav-btn {
    border: 1px solid rgba(27, 63, 139, 0.25);
    background: #ffffff;
    color: var(--color-deep, #1B3F8B);
    border-radius: 6px;
    padding: 0.4rem 0.75rem;
    font-size: 0.85rem;
    cursor: pointer;
    min-height: 2.25rem;
  }

  .nav-btn:hover:not(:disabled) {
    background: var(--color-base, #F0F6FF);
  }

  .nav-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .cal-week,
  :global(.cal-row) {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    column-gap: 2px;
  }

  .cal-week {
    font-size: 0.75rem;
    text-align: center;
    color: rgba(26, 31, 46, 0.6);
    margin-bottom: 4px;
  }

  .sun,
  :global(.cal-day.sun),
  :global(.list-wd.sun) {
    color: #B42318;
  }

  .sat,
  :global(.cal-day.sat),
  :global(.list-wd.sat) {
    color: #1F5FBF;
  }

  :global(.cal-row) {
    grid-template-rows: 22px repeat(var(--lanes, 2), 20px) 6px;
    row-gap: 2px;
    margin-bottom: 2px;
  }

  :global(.cal-cell) {
    grid-row: 1 / -1;
    background: #FAFBFD;
    border-radius: 6px;
  }

  :global(.cal-cell.is-blank) {
    background: transparent;
  }

  :global(.cal-cell.is-past) {
    background: #F4F5F7;
  }

  :global(.cal-cell.is-today) {
    box-shadow: inset 0 0 0 2px var(--color-deep, #1B3F8B);
  }

  :global(.cal-day) {
    grid-row: 1;
    z-index: 1;
    font-size: 0.75rem;
    padding: 3px 0 0 5px;
    color: #1A1F2E;
  }

  :global(.cal-bar) {
    z-index: 1;
    margin: 0 3px;
    border-radius: 4px;
    background: #FDE3C4;
    color: #6E3A08;
    font-size: 11px;
    line-height: 20px;
    padding: 0 4px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  :global(.cal-bar.is-multi) {
    background: #E8943A;
    color: #ffffff;
    font-weight: 700;
  }

  :global(.cal-bar.cont-l) {
    margin-left: -1px;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
  }

  :global(.cal-bar.cont-r) {
    margin-right: -1px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
  }

  :global(.cal-bar.is-past) {
    background: #e4e6ea;
    color: #555b6b;
  }

  :global(.cal-bar.is-multi.is-past) {
    background: #b7bcc6;
    color: #ffffff;
  }

  .list-heading {
    font-family: 'Noto Serif JP', serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-deep, #1B3F8B);
    padding-bottom: 0.4rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid rgba(110, 198, 240, 0.35);
  }

  :global(.month-list .list) {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0;
  }

  :global(.month-list .list[hidden]) {
    display: none;
  }

  :global(.past-list) {
    margin-bottom: 0.5rem;
  }

  :global(.fold) {
    display: block;
    width: 100%;
    text-align: left;
    background: none;
    border: 1px dashed rgba(27, 63, 139, 0.25);
    border-radius: 8px;
    padding: 0.55rem 0.9rem;
    margin-bottom: 0.5rem;
    font-size: 0.85rem;
    color: rgba(26, 31, 46, 0.65);
    cursor: pointer;
  }

  :global(.list-row) {
    display: flex;
    gap: 0.9rem;
    align-items: baseline;
    padding: 0.6rem 0.9rem;
    border-radius: 8px;
    background: #FFF6EC;
    border-left: 4px solid #E8943A;
  }

  :global(.list-row.is-past) {
    background: #F4F5F7;
    border-left-color: #b7bcc6;
    color: #8a909c;
  }

  :global(.list-when) {
    flex-shrink: 0;
    min-width: 7.5rem;
    display: flex;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #B96A18;
  }

  :global(.list-row.is-past .list-when),
  :global(.list-row.is-past .list-wd) {
    color: #8a909c;
  }

  :global(.list-body) {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  :global(.list-title) {
    font-size: 0.95rem;
    overflow-wrap: anywhere;
  }

  :global(.list-meta) {
    font-size: 0.8rem;
    color: rgba(26, 31, 46, 0.55);
  }

  .cal-empty,
  :global(.cal-empty) {
    text-align: center;
    color: rgba(26, 31, 46, 0.5);
    padding: 1.5rem 0;
    font-size: 0.95rem;
  }

  @media (max-width: 560px) {
    .calendar-card {
      padding: 0.6rem;
    }
    .nav-txt {
      display: none;
    }
    :global(.cal-row) {
      grid-template-rows: 22px repeat(var(--lanes, 2), 15px) 6px;
    }
    :global(.cal-bar) {
      font-size: 9px;
      line-height: 15px;
      padding: 0 2px;
      margin: 0 1px;
    }
    :global(.list-row) {
      flex-direction: column;
      gap: 0.2rem;
    }
    :global(.list-when) {
      min-width: 0;
    }
  }

  .schedule-footer {
    font-size: 0.875rem;
    color: rgba(26, 31, 46, 0.55);
    text-align: center;
  }

  .schedule-footer a {
    color: var(--color-deep, #1B3F8B);
    text-decoration: underline;
  }
</style>
