---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="スケジュール | 夢源風人"
  description="夢源風人の出演・練習会などのスケジュール。祭りの出演予定から日常の練習会まで、活動予定をカレンダーで確認できます。"
  pageTitle="スケジュール"
  pageSubtitle="Schedule"
>
  <div class="schedule-wrap">
    <div class="schedule-notice">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="notice-icon">
        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
      <span>
        練習場所・時間は天候その他の事情により変更する場合があります。
        見学希望の方は事前に<a href="/contact/">お問合せよりご連絡</a>ください。
      </span>
    </div>

    <div class="calendar-card">
      <div class="calendar-header">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        <span>活動カレンダー</span>
      </div>

      <div class="calendar-legend" aria-hidden="true">
        <span class="legend-item"><span class="legend-dot legend-dot--event"></span>祭り・イベント</span>
        <span class="legend-item"><span class="legend-dot legend-dot--practice"></span>練習</span>
      </div>

      <div class="calendar-body">
        <div id="calendar" class="calendar-list" aria-live="polite">
          <p class="cal-loading">予定を読み込んでいます…</p>
        </div>
      </div>
    </div>

    <p class="schedule-footer">
      ご不明な点は<a href="/contact/">お問合せ</a>ください。
    </p>
  </div>
</PageLayout>

<script>
  interface CalEvent {
    id: string;
    title: string;
    kind: '祭り・イベント' | '練習';
    isAllDay: boolean;
    startDate: string;
    endInclusive: string;
    startTime: string | null;
    location: string | null;
    recurring: boolean;
    htmlLink: string | null;
  }

  const WEEKDAYS = ['日', '月', '火', '水', '木', '金', '土'];

  function formatDay(dateStr: string): string {
    const [y, m, d] = dateStr.split('-').map(Number);
    const wd = WEEKDAYS[new Date(y, m - 1, d).getDay()];
    return `${m}月${d}日(${wd})`;
  }

  function formatWhen(ev: CalEvent): string {
    if (ev.startDate !== ev.endInclusive) {
      const [, sm, sd] = ev.startDate.split('-').map(Number);
      const [, em, ed] = ev.endInclusive.split('-').map(Number);
      return sm === em ? `${sm}月${sd}–${ed}日` : `${sm}/${sd}–${em}/${ed}`;
    }
    const day = formatDay(ev.startDate);
    return ev.startTime ? `${day} ${ev.startTime}` : day;
  }

  function monthLabel(key: string): string {
    const [y, m] = key.split('-');
    return `${y}年${Number(m)}月`;
  }

  function buildItem(ev: CalEvent): HTMLLIElement {
    const li = document.createElement('li');
    li.className = `cal-item kind-${ev.kind === '練習' ? 'practice' : 'event'}`;

    const when = document.createElement('span');
    when.className = 'cal-when';
    when.textContent = formatWhen(ev);
    li.appendChild(when);

    const body = document.createElement('div');
    body.className = 'cal-body';

    const title = document.createElement('span');
    title.className = 'cal-title';
    title.textContent = ev.recurring ? `${ev.title} ↻` : ev.title;
    body.appendChild(title);

    if (ev.location) {
      const loc = document.createElement('span');
      loc.className = 'cal-loc';
      loc.textContent = ev.location;
      body.appendChild(loc);
    }
    li.appendChild(body);
    return li;
  }

  async function render(): Promise<void> {
    const root = document.getElementById('calendar');
    if (!root) return;
    try {
      const res = await fetch('/api/calendar');
      const data = (await res.json()) as { events?: CalEvent[]; error?: string };
      const events = data.events ?? [];
      if (data.error || events.length === 0) {
        root.innerHTML = '<p class="cal-empty">現在表示できる予定はありません。</p>';
        return;
      }

      const groups = new Map<string, CalEvent[]>();
      for (const ev of events) {
        const key = ev.startDate.slice(0, 7);
        const list = groups.get(key) ?? [];
        list.push(ev);
        groups.set(key, list);
      }

      const frag = document.createDocumentFragment();
      for (const [key, list] of groups) {
        const section = document.createElement('section');
        section.className = 'cal-month';
        const h = document.createElement('h2');
        h.className = 'cal-month-title';
        h.textContent = monthLabel(key);
        section.appendChild(h);
        const ul = document.createElement('ul');
        ul.className = 'cal-month-list';
        for (const ev of list) ul.appendChild(buildItem(ev));
        section.appendChild(ul);
        frag.appendChild(section);
      }
      root.replaceChildren(frag);
    } catch {
      root.innerHTML =
        '<p class="cal-empty">予定の読み込みに失敗しました。時間をおいて再度お試しください。</p>';
    }
  }

  render();
</script>

<style>
  .schedule-wrap {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .schedule-notice {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    background: var(--color-base, #F0F6FF);
    border-left: 4px solid var(--color-sky, #6EC6F0);
    padding: 0.875rem 1.25rem;
    border-radius: 0 6px 6px 0;
    font-size: 0.9rem;
    line-height: 1.8;
    color: rgba(26, 31, 46, 0.75);
  }

  .notice-icon {
    flex-shrink: 0;
    margin-top: 0.2rem;
    color: var(--color-sky, #6EC6F0);
  }

  .schedule-notice a {
    color: var(--color-deep, #1B3F8B);
    text-decoration: underline;
  }

  .calendar-card {
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(27, 63, 139, 0.1);
    overflow: hidden;
    border: 1px solid rgba(27, 63, 139, 0.08);
  }

  .calendar-header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 1rem 1.25rem;
    background: var(--color-deep, #1B3F8B);
    color: #ffffff;
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .calendar-legend {
    display: flex;
    gap: 1.25rem;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid rgba(27, 63, 139, 0.08);
    font-size: 0.8rem;
    color: rgba(26, 31, 46, 0.7);
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .legend-dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    display: inline-block;
  }

  .legend-dot--event {
    background: #E8943A;
  }

  .legend-dot--practice {
    background: var(--color-sky, #6EC6F0);
  }

  .calendar-body {
    padding: 1.25rem;
  }

  .cal-loading,
  .cal-empty {
    text-align: center;
    color: rgba(26, 31, 46, 0.5);
    padding: 2.5rem 0;
    font-size: 0.95rem;
  }

  .cal-month + .cal-month {
    margin-top: 1.75rem;
  }

  .cal-month-title {
    font-family: 'Noto Serif JP', serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-deep, #1B3F8B);
    padding-bottom: 0.4rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid rgba(110, 198, 240, 0.35);
  }

  .cal-month-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cal-item {
    display: flex;
    gap: 0.9rem;
    align-items: baseline;
    padding: 0.6rem 0.9rem;
    border-radius: 8px;
    background: var(--color-base, #F0F6FF);
    border-left: 4px solid var(--color-sky, #6EC6F0);
  }

  .cal-item.kind-event {
    border-left-color: #E8943A;
    background: #FFF6EC;
  }

  .cal-when {
    flex-shrink: 0;
    min-width: 8.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-deep, #1B3F8B);
  }

  .cal-item.kind-event .cal-when {
    color: #B96A18;
  }

  .cal-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .cal-title {
    font-size: 0.95rem;
    color: var(--color-ink, #1A1F2E);
    overflow-wrap: anywhere;
  }

  .cal-loc {
    font-size: 0.8rem;
    color: rgba(26, 31, 46, 0.55);
  }

  @media (max-width: 560px) {
    .cal-item {
      flex-direction: column;
      gap: 0.2rem;
    }

    .cal-when {
      min-width: 0;
    }
  }

  .schedule-footer {
    font-size: 0.875rem;
    color: rgba(26, 31, 46, 0.55);
    text-align: center;
  }

  .schedule-footer a {
    color: var(--color-deep, #1B3F8B);
    text-decoration: underline;
  }
</style>
