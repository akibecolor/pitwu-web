MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=

# Google サービスアカウント（scripts/gcal.ts の予定 読み書き用）
# JSON ファイルの client_email と private_key を貼り付け
GOOGLE_SERVICE_ACCOUNT_EMAIL=       # client_email の値
GOOGLE_PRIVATE_KEY=                 # private_key の値（-----BEGIN ... END-----\n まるごと）

# スケジュールページ（公開カレンダー表示）用の read-only API キー。
# Calendar API を有効化した API キー。Pages Function (functions/api/calendar.ts) が使用。
# 本番は Cloudflare Pages の環境変数に設定。ローカルは `wrangler pages dev` 時のみ参照。
GOOGLE_CALENDAR_API_KEY=

# 参照するカレンダーIDの上書き（任意）。未設定なら既定（gcal-agent管理の公開カレンダー）。
# 将来 pitwu-app 公開先に寄せる場合などにコード変更なしで差し替える。
#   既定 EVENT:    80s4qcc8jd7hisb0k03vkist6g@group.calendar.google.com
#   既定 PRACTICE: slfifr2ssskd7c6e343jla5i00@group.calendar.google.com
#   例) pitwu-app 公開先に寄せる: EVENT_CALENDAR_ID=c_8c348a7de6...@group.calendar.google.com
EVENT_CALENDAR_ID=
PRACTICE_CALENDAR_ID=

# Cloudflare API トークン（ページ更新用）
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=